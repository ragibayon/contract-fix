# Copy this file to .env and supply your own key. Never commit .env.
OPENROUTER_API_KEY=
LLM_PROVIDER=openrouter
LLM_MODEL=google/gemini-3.8-flash
OPENROUTER_PROVIDER=Google AI Studio
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
LLM_CONTEXT_WINDOW=262144
LLM_MAX_OUTPUT_TOKENS=16384
LLM_THINKING=true
LLM_REASONING_EFFORT=low
LLM_REASONING_RESERVE_TOKENS=14336
LLM_TEMPERATURE=1.0
LLM_TOP_P=0.95
LLM_TOP_K=20
LLM_SEED=42
LLM_TIMEOUT_SECONDS=180
LLM_WALL_TIMEOUT_SECONDS=600
LLM_RATE_LIMIT_RETRIES=5
LLM_RATE_LIMIT_BASE_SECONDS=2.0
LLM_RATE_LIMIT_MAX_SECONDS=60.0
LLM_MAX_RETRIES=0
LLM_STRUCTURED_METHOD=tool
LLM_PROMPT_MAX_BYTES=1048576
